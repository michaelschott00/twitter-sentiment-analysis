#!/bin/bash

usage() {
  echo "Usage: $(basename "$0") {up|agent|dev|down|rebuild}"
  echo "  up       - docker compose up -d"
  echo "  agent    - run dev container and start agent"
  echo "  dev      - run dev container"
  echo "  down     - docker compose down"
  echo "  rebuild  - docker compose down && docker compose build"
}

case "$1" in
  up)
    docker compose up -d
    ;;
  agent)
    HERDR_AGENT=opencode docker compose run --rm --remove-orphans --entrypoint "" dev opencode
    ;;
  dev)
    HERDR_AGENT=opencode docker compose run --rm --remove-orphans dev
    ;;
  down)
    docker compose down
    ;;
  rebuild)
    docker compose down && docker compose build
    ;;
  *)
    usage
    exit 1
    ;;
esac
