#!/bin/bash

usage() {
  echo "Usage: $(basename "$0") {up|agent|dev|down|rebuild}"
  echo "  up              - docker compose up -d"
  echo "  agent           - run dev container and start agent"
  echo "  dev             - run dev container"
  echo "  gateway         - run gateway container"
  echo "  down            - docker compose down"
  echo "  restart         - docker compose down and up"
  echo "  rebuild         - docker compose down && docker compose build"
  echo "  update-gateway  - restart gateway with updated tools.yaml"
}

case "$1" in
  up)
    docker compose up -d
    ;;
  agent)
    HERDR_AGENT=opencode docker compose run --rm --remove-orphans --entrypoint "" dev opencode
    ;;
  dev)
    HERDR_AGENT=opencode docker compose run --rm --remove-orphans dev
    ;;
  gateway)
    docker compose exec -it tool-gateway /bin/bash
    ;;
  down)
    docker compose down
    ;;
  restart)
    docker compose down && docker compose up -d
    ;;
  rebuild)
    docker compose down && docker compose build && docker compose up -d
    ;;
  update-gateway)
    docker compose down tool-gateway && docker compose up tool-gateway -d
    ;;
  *)
    usage
    exit 1
    ;;
esac
