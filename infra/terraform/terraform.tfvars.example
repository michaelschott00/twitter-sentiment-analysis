# Copy to a local *.tfvars file (gitignored) or adapt environments/dev.tfvars.
# These values mirror the variable defaults; uncomment and adjust as needed.
#
# env               = "dev"
# location          = "westeurope"
# prefix            = "twitterml"
# compute_vm_size   = "Standard_NC4as_T4_v3"
# compute_min_nodes = 0
# compute_max_nodes = 2
# vm_priority       = "LowPriority"
# cpu_vm_size       = "Standard_DS3_v2"
# budget_amount     = 50
# owner             = "agent"
