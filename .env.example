# Local dev convenience. Copy to `.env` (gitignored) and fill in after
# `terraform apply` (see infra/terraform/README.md).
#
# Workspace-managed MLflow (plan section 6.3). Either point at Azure
# (requires `az login`) or at a local tracking server:
#   mlflow server --backend-store-uri sqlite:///mlflow.db --default-artifact-root ./mlruns
MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_TRACKING_URI=azureml://westeurope.api.azureml.ms/mlflow/v1.0/<workspace-id>

AZURE_SUBSCRIPTION_ID=
